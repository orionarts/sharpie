// Sharpie main window {{{1
//
import {
    GroupBox,
    HorizontalBox,
    TabWidget,
    TextEdit,
    VerticalBox,
} from "std-widgets.slint";

import { HullFields,
         HullComputed,
         HullTab,
         ShipIdentity }   from "tabs/hull.slint";
import { FreeboardTab }   from "tabs/freeboard.slint";
import { TorpedoFields,
         TorpedoDerived } from "tabs/weapons.slint";
import { MineFields,
         MineDerived }    from "tabs/weapons.slint";
import { ASWFields,
         ASWDerived }     from "tabs/weapons.slint";
import { WeightFields }   from "tabs/weapons.slint";
import { GunsTab }        from "tabs/guns/guns.slint";
import { WeaponsTab }     from "tabs/weapons.slint";
import { ArmorTab,
         ArmorComputed,
         ArmorFields }    from "tabs/armor.slint";
import { EnginesTab }     from "tabs/engines.slint";
import { PerformanceTab } from "tabs/performance.slint";

import { Layout         } from "layout.slint";

export { AboutDialog } from "dialogs/about-dialog.slint";

// Main window {{{1
//
export component MainWindow inherits Window {
    title: "Sharpie";
    width: Layout.tab-width +
        (root.report-visible ? Layout.report-width : 0px);
    height: Layout.gui-height;

    in-out property <ShipIdentity> identity;
    in-out property <HullFields> hull-fields;
    in-out property <HullComputed> hull-computed;
    in-out property <image> hull-image;

    in-out property <[TorpedoFields]>  torp-fields;
    in-out property <[TorpedoDerived]> torp-derived;
    in-out property <[MineFields]>     mine-fields;
    in-out property <[MineDerived]>    mine-derived;
    in-out property <[ASWFields]>      asw-fields;
    in-out property <[ASWDerived]>     asw-derived;
    in-out property <WeightFields>     weight-fields;

    in-out property <ArmorFields>      armor-fields;
    in-out property <ArmorComputed>    armor-computed;

    in-out property <[string]> asw-type-labels: [];
    in-out property <[string]> bow-labels: [];
    in-out property <[string]> mine-type-labels: [];
    in-out property <[string]> stern-labels: [];
    in-out property <[string]> torp-mount-labels: [];
    in-out property <[string]> bh-kind-labels: [];
    in-out property <[string]> deck-kind-labels: [];

    in-out property <[string]> length-small-labels: [];
    in-out property <[string]> length-long-labels: [];

    in-out property <[string]> weights-labels: [];

    in-out property <string> report-str: "Load or create a ship";
    in-out property <bool> report-visible: false;

    // Menu callbacks
    callback load-ship();
    callback save-ship();
    callback convert-ship();
    callback clear-ship();
    callback exit-app();
    callback toggle-report();
    callback show-about();

    // Other callbacks
    callback field-edited();
    callback draft-edited();
    callback depth-lock-toggled();
    callback freeboards-est(which: int);
    callback save-picture();
    callback torp-units-edited(row: int);
    callback mine-units-edited();
    callback asw-units-edited(row: int);
    callback hull-units-edited();
    callback armor-units-edited();
    callback armor-default();
    callback set-all-units(which: int);

    // Menu bar {{{2
    //
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open ship";                shortcut: @keys(Control + O);         activated => { root.load-ship(); } }
            MenuItem { title: "Save ship";                shortcut: @keys(Control + S);         activated => { root.save-ship(); } }
            MenuItem { title: "Convert SpringSharp ship"; shortcut: @keys(Control + Shift + O); activated => { root.convert-ship(); } }
            MenuSeparator {}
            MenuItem { title: "Clear all";                                                      activated => { root.clear-ship(); } }
            MenuSeparator {}
            MenuItem { title: "Exit";                                                           activated => { root.exit-app(); } }
        }
        Menu {
            title: "View";
            MenuItem { title: root.report-visible ? "Hide Report" : "Show Report"; shortcut: @keys(Control + R); activated => { root.toggle-report(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "About Sharpie"; shortcut: @keys(F1); activated => { root.show-about(); } }
        }
    }

    // Tabs {{{2
    //
    VerticalBox {
        HorizontalBox {
            TabWidget {
                width: Layout.tab-width;
                Tab {
                    title: "Hull";
                    HullTab {
                        identity <=> root.identity;
                        hull-fields <=> root.hull-fields;
                        hull-computed <=> root.hull-computed;
                        field-edited => { root.field-edited(); }
                        draft-edited => { root.draft-edited(); }
                        hull-units-edited => { root.hull-units-edited(); }
                        length-long-labels <=> root.length-long-labels;
                    }
                }
                Tab {
                    title: "Freeboard";
                    FreeboardTab {
                        hull-image <=> root.hull-image;
                        hull-fields <=> root.hull-fields;
                        bow-labels <=> root.bow-labels;
                        stern-labels <=> root.stern-labels;
                        field-edited => { root.field-edited(); }
                        save-picture => { root.save-picture(); }
                        depth-lock-toggled => { root.depth-lock-toggled(); }
                        set-freeboards(which) => { root.freeboards-est(which); }
                    }
                }
                Tab {
                    title: "Guns";
                    GunsTab {
                        field-edited => { root.field-edited(); }
                    }
                }
                Tab {
                    title: "Weapons";
                    WeaponsTab {
                        torp-fields <=> root.torp-fields;
                        torp-derived <=> root.torp-derived;
                        mine-fields <=> root.mine-fields;
                        mine-derived <=> root.mine-derived;
                        asw-fields <=> root.asw-fields;
                        asw-derived <=> root.asw-derived;
                        weight-fields <=> root.weight-fields;
                        asw-type-labels <=> root.asw-type-labels;
                        mine-type-labels <=> root.mine-type-labels;
                        torp-mount-labels <=> root.torp-mount-labels;
                        length-small-labels <=> root.length-small-labels;
                        weights-labels <=> root.weights-labels;
                        field-edited => { root.field-edited(); }
                        torp-units-edited(row) => { root.torp-units-edited(row); }
                        mine-units-edited => { root.mine-units-edited(); }
                        asw-units-edited(row) => { root.asw-units-edited(row); }
                    }
                }
                Tab {
                    title: "Armor";
                    ArmorTab {
                        armor-fields <=> root.armor-fields;
                        armor-computed <=> root.armor-computed;
                        length-small-labels <=> root.length-small-labels;
                        field-edited => { root.field-edited(); }
                        armor-units-edited => { root.armor-units-edited(); }
                        armor-default => { root.armor-default(); }
                        bh-kind-labels <=> root.bh-kind-labels;
                        deck-kind-labels <=> root.deck-kind-labels;
                    }
                }
                Tab {
                    title: "Engines";
                    EnginesTab {
                        field-edited => { root.field-edited(); }
                    }
                }
                Tab {
                    title: "Performance";
                    PerformanceTab {
                        field-edited => { root.field-edited(); }
                    }
                }
            }

            GroupBox {
                title: "Report";
                visible: root.report-visible;
                report := TextEdit { text: root.report_str; read-only: true; }
            }
        }
    }
}
