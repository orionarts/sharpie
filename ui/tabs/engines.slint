import {
    Button,
    CheckBox,
    GridBox,
    HorizontalBox,
    ScrollView,
    VerticalBox,
} from "std-widgets.slint";

import { Entry }       from "../widgets/entry.slint";
import { RowLabel }    from "../widgets/row-label.slint";
import { ColumnLabel } from "../widgets/column-label.slint";
import { TickSlider }  from "../widgets/tick-slider.slint";
import { Layout }      from "../layout.slint";

// Engines tab {{{1
//
export struct EngineFields {
    vmax: string,
    vmax-value: float,
    vcruise: string,
    shafts: string,
    range: string,
    pct-coal: string,

    // Power lock (SpringSharp's "Lock Power"). UI state only; the two
    // stashes hold the horsepower and bunkerage captured when locked.
    power-locked: bool,
    hp-target: string,
    hp-stash: float,
    bunker-stash: float,

    fuel-coal: bool,
    fuel-oil: bool,
    fuel-diesel: bool,
    fuel-petrol: bool,
    fuel-battery: bool,

    boiler-simple: bool,
    boiler-complex: bool,
    boiler-turbine: bool,

    drive-direct: bool,
    drive-geared: bool,
    drive-electric: bool,
    drive-hydraulic: bool,
}

export struct EngineComputed {
    frict-max: string,
    wave-max: string,
    powwave-max: string,
    hp-max: string,
    kw-max: string,

    frict-cruise: string,
    wave-cruise: string,
    powwave-cruise: string,
    hp-cruise: string,
    kw-cruise: string,

    d-engine: string,
    wgt-engine: string,
    bunker-max: string,
    bunker-normal: string,

    wgt-load: string,
    wgt-hull: string,
    d-factor: string,

    fuel-desc: string,
    boiler-desc: string,
    drive-desc: string,
}

export component EnginesTab inherits ScrollView {
    callback field-edited();
    callback shafts-edited();
    callback vmax-slider-changed();
    callback power-lock-toggled();
    callback power-recalc();

    in-out property <EngineFields>   engine-fields;
    in-out property <EngineComputed> engine-computed;

    VerticalBox {
        alignment: start;
        GridBox {
            spacing: Layout.grid-spacing;

            Row {
                // These blank widgets are solely so we can set column widths in the
                // first row
                Text { height: 0px; width: Layout.label-width; }
                Text { height: 0px; width: Layout.edit-width; }
                Text { height: 0px; width: Layout.edit-width; }
                Text { height: 0px; width: Layout.edit-width; }
                Text { height: 0px; width: Layout.edit-width; }
                Text { height: 0px; width: Layout.edit-width; }
            }

            Row {
                Text { colspan: 3; text: "Speed & Power:"; font-weight: 700; vertical-alignment: bottom; }
            }

            Row {
                RowLabel { text: "Max speed:"; }
                Entry { text <=> root.engine-fields.vmax; edited => { root.field-edited(); }; enabled: !root.engine-fields.power-locked; }
                TickSlider {
                    colspan: 4;
                    minimum: 0;
                    maximum: 50;
                    step: 1;
                    tick-step: 5;
                    label-step: 10;
                    precision: 0;
                    overhang: true;
                    start-extra: "Max knots";
                    value <=> root.engine-fields.vmax-value;
                    changed => { root.vmax-slider-changed(); }
                }
            }

            Row {
                RowLabel { text: "Cruise speed:"; }
                Entry { text <=> root.engine-fields.vcruise; edited => { root.field-edited(); } }
                // Power lock (SpringSharp's "Lock Power" / "Recalc"). While
                // locked the max speed is a frozen Recalc result; the target
                // horsepower is edited instead and the power and bunkerage
                // derived from it.
                Button {
                    col: 3;
                    text: root.engine-fields.power-locked ? "Unlock Power" : "Lock Power";
                    clicked => {
                        root.engine-fields.power-locked = !root.engine-fields.power-locked;
                        root.power-lock-toggled();
                    }
                }
                Button {
                    visible: root.engine-fields.power-locked;
                    text: "Recalc";
                    enabled: root.engine-fields.power-locked;
                    clicked => { root.power-recalc(); }
                }
            }

            Row {
                RowLabel { text: "No. of shafts:"; }
                Entry { text <=> root.engine-fields.shafts; edited => { root.shafts-edited(); } }
                RowLabel { visible: root.engine-fields.power-locked; text: "Desired hp:"; }
                Entry {
                    visible: root.engine-fields.power-locked;
                    text <=> root.engine-fields.hp-target;
                    enabled: root.engine-fields.power-locked;
                    edited => { root.field-edited(); }
                }
            }

            Row {
                ColumnLabel { col: 1; text: "Friction\nresistance:"; }
                ColumnLabel { text: "Wave\nresistance:"; }
                ColumnLabel { text: "Power to\nwavemaking:"; }
                ColumnLabel { text: "Power (hp):"; }
                ColumnLabel { text: "Power (Kw):"; }
            }

            Row {
                RowLabel { text: "Max:"; }
                Entry { text: root.engine-computed.frict-max; enabled: false; }
                Entry { text: root.engine-computed.wave-max; enabled: false; }
                Entry { text: root.engine-computed.powwave-max + " %"; enabled: false; }
                Entry { text: root.engine-computed.hp-max; enabled: false; }
                Entry { text: root.engine-computed.kw-max; enabled: false; }
            }

            Row {
                RowLabel { text: "Cruise:"; }
                Entry { text: root.engine-computed.frict-cruise; enabled: false; }
                Entry { text: root.engine-computed.wave-cruise; enabled: false; }
                Entry { text: root.engine-computed.powwave-cruise + " %"; enabled: false; }
                Entry { text: root.engine-computed.hp-cruise; enabled: false; }
                Entry { text: root.engine-computed.kw-cruise; enabled: false; }
            }

            Row {
                Text { colspan: 3; text: "Engines:"; font-weight: 700; vertical-alignment: bottom; }
            }

            Row {
                HorizontalBox {
                    col: 1;
                    colspan: 5;

                    Rectangle {
                        border-width: 1px;
                        border-color: white;
                        horizontal-stretch: 1;
                        preferred-width: 0;
                        min-width: 0;
                        VerticalBox {
                            CheckBox { text: "Coal fired boilers"; checked <=> root.engine-fields.fuel-coal; toggled => { root.field-edited(); } }
                            CheckBox { text: "Oil fired boilers"; checked <=> root.engine-fields.fuel-oil; toggled => { root.field-edited(); } }
                            CheckBox { text: "Diesel motors"; checked <=> root.engine-fields.fuel-diesel; toggled => { root.field-edited(); } }
                            CheckBox { text: "Petrol motors"; checked <=> root.engine-fields.fuel-petrol; toggled => { root.field-edited(); } }
                            CheckBox { text: "Batteries"; checked <=> root.engine-fields.fuel-battery; toggled => { root.field-edited(); } }
                        }
                    }
                    Rectangle {
                        border-width: 1px;
                        border-color: white;
                        horizontal-stretch: 1;
                        preferred-width: 0;
                        min-width: 0;
                        VerticalBox {
                            CheckBox { text: "Simple reciprocating"; checked <=> root.engine-fields.boiler-simple; toggled => { root.field-edited(); } }
                            CheckBox { text: "Complex reciprocating"; checked <=> root.engine-fields.boiler-complex; toggled => { root.field-edited(); } }
                            CheckBox { text: "Steam turbines"; checked <=> root.engine-fields.boiler-turbine; toggled => { root.field-edited(); } }
                        }
                    }
                    Rectangle {
                        border-width: 1px;
                        border-color: white;
                        horizontal-stretch: 1;
                        preferred-width: 0;
                        min-width: 0;
                        VerticalBox {
                            CheckBox { text: "Direct"; checked <=> root.engine-fields.drive-direct; toggled => { root.field-edited(); } }
                            CheckBox { text: "Geared"; checked <=> root.engine-fields.drive-geared; toggled => { root.field-edited(); } }
                            CheckBox { text: "Electric"; checked <=> root.engine-fields.drive-electric; toggled => { root.field-edited(); } }
                            CheckBox { text: "Hydraulic"; checked <=> root.engine-fields.drive-hydraulic; toggled => { root.field-edited(); } }
                        }
                    }
                }
            }

            Row {
                Text { col: 1; colspan: 5;
                text:
                    root.engine-computed.fuel-desc + ", " +
                    root.engine-computed.boiler-desc + ", " +
                    root.engine-computed.drive-desc;
                }
            }

            Row { Text { } }

            Row {
                Text { colspan: 3; text: "Weights:"; font-weight: 700; vertical-alignment: bottom; }
            }

            Row {
                RowLabel { text: "Range:"; }
                Entry { text <=> root.engine-fields.range; edited => { root.field-edited(); } }
            }

            Row {
                RowLabel { text: "% Coal:"; }
                Entry { text <=> root.engine-fields.pct-coal; edited => { root.field-edited(); } }
            }

            Row {
                ColumnLabel { col: 1; text: "Engine disp for\nmachinery:"; }
                ColumnLabel { text: "Engine:"; }
                ColumnLabel { text: "Bunker (Max):"; }
                ColumnLabel { text: "Bunker (Normal):"; }
            }

            Row {
                RowLabel { text: "Engine:"; }
                Entry { text: root.engine-computed.d-engine; enabled: false; }
                Entry { text: root.engine-computed.wgt-engine; enabled: false; }
                Entry { text: root.engine-computed.bunker-max; enabled: false; }
                Entry { text: root.engine-computed.bunker-normal; enabled: false; }
            }

            Row {
                ColumnLabel { col: 1; text: "Load:"; }
                ColumnLabel { text: "Hull:"; }
                ColumnLabel { text: "Displacement\nfactor:"; }
            }

            Row {
                RowLabel { text: "Weight:"; }
                Entry { text: root.engine-computed.wgt-load; enabled: false; }
                Entry { text: root.engine-computed.wgt-hull; enabled: false; }
                Entry { text: root.engine-computed.d-factor; enabled: false; }
            }
        }
    }
}
