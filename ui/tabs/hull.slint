import {
    LineEdit,
    VerticalBox,
    HorizontalBox,
    GroupBox,
    GridBox,
    ScrollView,
} from "std-widgets.slint";
import { FieldRow } from "../widgets/field-row.slint";

// Ship entry fields {{{1
//
export struct ShipIdentity {
    name: string,
    country: string,
    kind: string,
    year: string,
}

// Hull entry fields {{{1
//
export struct HullFields {
    // Either/or pairs: *-kind records which LineEdit was edited last
    // (0 = first, 1 = second); the other shows the derived counterpart
    disp-kind: int,
    disp-cb: string,
    disp-d: string,

    len-kind: int,
    len-lwl: string,
    len-loa: string,

    b: string,
    bb: string,
    t: string,

    bow-type: int,
    ram-len: string,
    stern-type: int,
    stern-overhang: string,

    // Deck lengths are fractions of total deck, shown and entered as %
    fc-len: string,
    fd-len: string,
    qd-len: string,

    fc-fwd: string,
    fc-aft: string,
    fd-fwd: string,
    fd-aft: string,
    ad-fwd: string,
    ad-aft: string,
    qd-fwd: string,
    qd-aft: string,

    bow-angle: string,
}

// Hull tab {{{1
//
export component HullTab inherits ScrollView {
    in-out property <ShipIdentity> identity: {
        name: "",
        country: "",
        kind: "",
        year: "1950",
    };
    in-out property <HullFields> hull-fields: {
        disp-kind: 0,
        disp-cb: "",
        disp-d: "",
        len-kind: 0,
        len-lwl: "",
        len-loa: "",
        b: "",
        bb: "",
        t: "",
        bow-type: 0,
        ram-len: "",
        stern-type: 0,
        stern-overhang: "",
        fc-len: "",
        fd-len: "",
        qd-len: "",
        fc-fwd: "",
        fc-aft: "",
        fd-fwd: "",
        fd-aft: "",
        ad-fwd: "",
        ad-aft: "",
        qd-fwd: "",
        qd-aft: "",
        bow-angle: "",
    };

    callback field-edited();

    VerticalBox {
        GroupBox {
            title: "Ship Identity";
            VerticalBox {
                FieldRow {
                    label: "Name:";
                    LineEdit {
                        text <=> root.identity.name;
                        edited => { root.field-edited(); }
                    }
                }
                FieldRow {
                    label: "Country:";
                    LineEdit {
                        text <=> root.identity.country;
                        edited => { root.field-edited(); }
                    }
                }
                FieldRow {
                    label: "Kind:";
                    LineEdit {
                        text <=> root.identity.kind;
                        edited => { root.field-edited(); }
                    }
                }
                FieldRow {
                    label: "Year:";
                    LineEdit {
                        text <=> root.identity.year;
                        edited => { root.field-edited(); }
                    }
                }
            }
        }

        GroupBox {
            title: "Dimensions";
            VerticalBox {
                HorizontalBox {
                    Text { text: "Cb:"; width: 40px; vertical-alignment: center; }
                    LineEdit {
                        width: 70px;
                        text <=> root.hull-fields.disp-cb;
                        edited => {
                            root.hull-fields.disp-kind = 0;
                            root.field-edited();
                        }
                    }
                    Text { text: "Disp (t):"; width: 55px; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.hull-fields.disp-d;
                        edited => {
                            root.hull-fields.disp-kind = 1;
                            root.field-edited();
                        }
                    }
                }
                HorizontalBox {
                    Text { text: "LWL:"; width: 40px; vertical-alignment: center; }
                    LineEdit {
                        width: 70px;
                        text <=> root.hull-fields.len-lwl;
                        edited => {
                            root.hull-fields.len-kind = 0;
                            root.field-edited();
                        }
                    }
                    Text { text: "LOA:"; width: 40px; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.hull-fields.len-loa;
                        edited => {
                            root.hull-fields.len-kind = 1;
                            root.field-edited();
                        }
                    }
                }
                HorizontalBox {
                    Text { text: "Beam:"; width: 80px; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.hull-fields.b;
                        edited => { root.field-edited(); }
                    }
                }
                HorizontalBox {
                    Text { text: "Beam bulges:"; width: 80px; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.hull-fields.bb;
                        edited => { root.field-edited(); }
                    }
                }
                HorizontalBox {
                    Text { text: "Draft:"; width: 80px; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.hull-fields.t;
                        edited => { root.field-edited(); }
                    }
                }
            }
        }
    }
}
