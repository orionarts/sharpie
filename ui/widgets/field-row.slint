import { HorizontalBox } from "std-widgets.slint";
import { Layout }        from "../layout.slint";

// FieldRow {{{1
/// Reusable label-plus-content row
///
export component FieldRow inherits HorizontalBox {
    in property <string> label;
    Text {
        text: root.label;
        width: Layout.label-width;
        vertical-alignment: center;
    }
    @children
}
